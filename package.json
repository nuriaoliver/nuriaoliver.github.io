{
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('_site', { recursive: true, force: true })\"",
    "build": "npm run clean && eleventy && npm run validate:assets",
    "validate:assets": "node scripts/validate-asset-sizes.mjs _site",
    "test": "node --test",
    "start": "eleventy --serve",
    "deploy": "npx wrangler deploy",
    "deploy:preview": "npx wrangler versions upload"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@retorquere/bibtex-parser": "^11.0.0",
    "bootstrap": "^5.3.8",
    "markdown-it": "^15.0.2"
  }
}

<!DOCTYPE html>
<html lang="{{ lang or 'en' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ seo.title }}</title>
    {% if seo.description %}<meta name="description" content="{{ seo.description }}">{% endif %}
    <link rel="canonical" href="{{ seo.canonicalUrl }}">{% if altpage %}
    <link rel="alternate" hreflang="{{ lang }}" href="{{ site.url }}{{ page.url }}">
    <link rel="alternate" hreflang="{{ altpage.lang }}" href="{{ site.url }}{{ altpage.url }}">
    <link rel="alternate" hreflang="x-default" href="{{ seo.xDefaultUrl }}">
    {% endif %}
    <link rel="icon" href="/favicons/favicon-96x96.png" sizes="96x96" type="image/png">
    <link rel="icon" href="/favicons/favicon-32x32.png" sizes="32x32" type="image/png">
    <link rel="apple-touch-icon" href="/favicons/apple-icon-180x180.png">
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <script src="/js/bootstrap.bundle.min.js" defer></script>
    <link rel="stylesheet" href="/css/nav.css">
    {% if home %}<link rel="stylesheet" href="/css/home.css">{% endif %}
    {% if bio %}<link rel="stylesheet" href="/css/bio.css">{% endif %}
    {% if page.url == '/summary/' %}<script src="/js/contact.js" defer></script>{% endif %}
    {% if page.url == '/pictures/' %}<link rel="stylesheet" href="/css/photos.css">{% endif %}
    {% if page.url == '/awards/' %}<link rel="stylesheet" href="/css/awards.css">{% endif %}
    {% if page.url == '/invitedtalks/' %}
    <link rel="stylesheet" href="/css/invited-talks.css">
    <script src="/js/invited-talks.js" defer></script>
    {% endif %}
    {% if page.url == '/programcommittees/' %}
    <link rel="stylesheet" href="/css/programcommittees.css">
    <script src="/js/programcommittees.js" defer></script>
    {% endif %}
    {% if page.url == '/press/' %}
    <link rel="stylesheet" href="/css/press.css">
    <script src="/js/press.js" defer></script>
    {% endif %}
    {% if seo.structuredData %}
    <script type="application/ld+json">
    {{ seo.structuredData | jsonLd | safe }}
    </script>
    {% endif %}
  </head>
  <body>
    <header>
      {% include "nav.njk" %}
    </header>
    <main role="main" class="{% if home %}home-page{% endif %}{% if page.url == '/awards/' %} awards-page{% endif %}{% if page.url == '/programcommittees/' %} service-page{% endif %}{% if page.url == '/press/' %} press-page{% endif %}">
      <div class="container">
        {% if seo.breadcrumbs.length %}
        <nav class="site-breadcrumbs" aria-label="{{ seo.breadcrumbAriaLabel }}">
          <ol class="breadcrumb">
            {% for crumb in seo.breadcrumbs %}
            <li class="breadcrumb-item{% if loop.last %} active{% endif %}"{% if loop.last %} aria-current="page"{% endif %}>
              {% if loop.last %}{{ crumb.name }}{% else %}<a href="{{ crumb.url }}">{{ crumb.name }}</a>{% endif %}
            </li>
            {% endfor %}
          </ol>
        </nav>
        {% endif %}
        {{ content | safe }}
      </div>
    </main>
  </body>
</html>

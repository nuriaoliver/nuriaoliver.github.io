<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if title %}{{ title }} | Nuria Oliver{% else %}Nuria Oliver{% endif %}</title>
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <script src="/js/bootstrap.bundle.min.js" defer></script>
    <link rel="stylesheet" href="/css/nav.css">
    {% if page.url and page.url.startsWith('/projects/') and page.url != '/projects/' %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home",     "item": "{{ site.url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Projects", "item": "{{ site.url }}/projects/" },
        { "@type": "ListItem", "position": 3, "name": {{ title | dump | safe }}, "item": "{{ site.url }}{{ page.url }}" }
      ]
    }
    </script>
    {% endif %}
  </head>
  <body>
    <header>
      {% include "nav.njk" %}
    </header>
    <main role="main" style="padding-top: 80px;">
      <div class="container">
        {{ content | safe }}
      </div>
    </main>
  </body>
</html>

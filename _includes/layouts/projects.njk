---
layout: base.njk
---
<style>
.projects-page h1 { margin-bottom: 1rem; }
.projects-intro { color: #555; margin-bottom: 2rem; }
.projects-intro a { color: #0d6efd; }

.category-section { margin-bottom: 3rem; }
.category-heading {
  font-size: 1.15rem;
  font-weight: 700;
  color: #1a1a2e;
  padding-bottom: 0.4rem;
  border-bottom: 2px solid #0d6efd;
  margin-bottom: 1.5rem;
  margin-top: 2.5rem;
}

.project-card {
  border: 1px solid #e8e8e8;
  border-radius: 8px;
  transition: box-shadow 0.18s ease, transform 0.18s ease;
  overflow: hidden;
  color: inherit;
  text-decoration: none !important;
  display: flex;
  flex-direction: column;
  height: 100%;
}
.project-card:hover {
  box-shadow: 0 6px 20px rgba(0,0,0,0.10);
  transform: translateY(-3px);
  color: inherit;
}
.project-card-body {
  padding: 0.75rem 1rem 1rem;
  flex: 1;
  display: flex;
  flex-direction: column;
}
.project-card-title {
  font-size: 0.9rem;
  font-weight: 600;
  color: #1a1a2e;
  line-height: 1.35;
  margin-bottom: 0.5rem;
}
.project-years {
  font-size: 0.78rem;
  color: #fff;
  background: #6c757d;
  border-radius: 20px;
  padding: 1px 8px;
  display: inline-block;
  margin-top: auto;
}
</style>

<div class="projects-page">
  <h1>{{ title }}</h1>
  <div class="projects-intro">
    {{ content | safe }}
  </div>

  {% for section in collections.projectsByCategory %}
  <section class="category-section" id="{{ section.id }}">
    <h2 class="category-heading">{{ section.category }}</h2>
    <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 g-3">
      {% for p in section.projects %}
      <div class="col">
        <a href="{{ p.url }}" class="project-card">
          <div class="project-card-body">
            <div class="project-card-title">{{ p.data.title }}</div>
            {% if p.data.years %}
            <span class="project-years">{{ p.data.years }}</span>
            {% endif %}
          </div>
        </a>
      </div>
      {% endfor %}
    </div>
  </section>
  {% endfor %}
</div>

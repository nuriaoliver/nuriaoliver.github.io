{% set localizedBook = featuredBook.locales[lang] %}
<section class="home-section home-book" aria-labelledby="book-title">
	<img class="home-book__cover" src="{{ featuredBook.cover }}" alt="{{ localizedBook.coverAlt }}">
	<div class="home-book__content">
		<p class="home-section__label">{{ localizedBook.label }}</p>
		<h2 id="book-title"><cite>{{ featuredBook.title }}</cite></h2>
		<p>{{ localizedBook.byline }}</p>
		<a class="home-book__link" href="{{ featuredBook.url | escape }}">{{ localizedBook.cta }} <span aria-hidden="true">→</span></a>
	</div>
</section>
